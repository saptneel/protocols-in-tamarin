theory TLS13_Mini_Fixed
begin

builtins: diffie-hellman, asymmetric-encryption, hashing, signing

// 1. PKI Infrastructure
rule Register_pk:
    [ Fr(~ltk) ] --> [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)) ]

// 2. Client Hello: Generates DH ephemeral key (gx)
rule Client_Hello:
    [ Fr(~x), !Pk($S, pkS) ]
  -->
    [ Client_Sent_CH($C, $S, ~x)
    , Out(<'ClientHello', 'gx', 'g'^~x>) 
    ]

// 3. Server Hello: Receives gx, generates gy, signs the transcript
rule Server_Hello:
    let 
        shared_secret = gx^~y
        transcript = <'ClientHello', 'gx', gx, 'ServerHello', 'gy', 'g'^~y>
    in
    [ !Ltk($S, ~ltkS)
    , In(<'ClientHello', 'gx', gx>)
    , Fr(~y) 
    ]
  --[ Server_Finished($S, shared_secret) ]->
    [ Server_Sent_SH($S, gx, ~y)
    , Out(<'ServerHello', 'gy', 'g'^~y, sign(transcript, ~ltkS)>) 
    ]

// 4. Client Finish: Verifies server signature and derives shared secret
rule Client_Finish:
    let 
        shared_secret = gy^~x
        transcript = <'ClientHello', 'gx', 'g'^~x, 'ServerHello', 'gy', gy>
    in
    [ Client_Sent_CH($C, $S, ~x)
    , !Pk($S, pkS)
    , In(<'ServerHello', 'gy', gy, sig>)
    ]
  --[ Client_Finished($C, shared_secret), 
      Eq(verify(sig, transcript, pkS), true) ]->
    [ Client_Established($C, $S, shared_secret) ]

/* --- Restrictions --- */
restriction Equality:
    "All x y #i. Eq(x,y) @ i ==> x = y"

/* --- Lemmas --- */

// Fixed: No hyphenated keywords. Universal quantification is inside the string.
lemma Perfect_Forward_Secrecy:
    "All s #i. Client_Finished('Alice', s) @ #i ==> 
     not(Ex #j. K(s) @ #j) | (Ex #r. LtkReveal('Server') @ r)"

// Fixed: No hyphenated keywords. Existential quantification is inside the string.
lemma Handshake_Possible:
    exists-trace
    "Ex C s #i. Client_Finished(C, s) @ #i"

end