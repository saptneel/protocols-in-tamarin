theory double_aenc
    // configuration: "--auto-sources"
begin

builtins: asymmetric-encryption

restriction UniqueKeyReg:
    "All X k1 k2 #i #j. ((KeyReg(X, k1) @ i) & (KeyReg(X, k2) @ j)) ==> #i = #j"

restriction Neq:
    "All x y #i. Neq(x, y) @ i ==> not (x = y)"

restriction Eq:
    "All x y #i. Eq(x, y) @ i ==> (x = y)"

rule Register:
    [Fr(~k)]
    --[KeyReg($X, ~k)]->
    [!Ltk($X, ~k), !Pk($X, pk(~k)), Out(pk(~k))]

// rule Compromise:
//     [!Ltk($X, ~k)]
//     --[Compromised($X)]->
//     [Out(~k)]

rule A_Init:
    let inM = aenc(<'msg', ~m>, pkB)
        outM = aenc(<'init', $A, inM>, pkB)
    in
    [!Ltk($A, k), !Pk($B, pkB), Fr(~m)]
    --[RunningA($A, $B, ~m), Neq($A, $B), Encrypts(inM), Encrypts(outM)]->
    [Out(<$B, outM>), StateA($A, $B, ~m)]

rule B_Resp:
    let inner = adec(dencM, k)
        tag = fst(inner)
        A = fst(snd(inner))
        encM = snd(snd(inner))
        msg = adec(encM, k)
        m = snd(msg)
        inM = aenc(<'msg', m>, pkA)
        outM = aenc(<'resp', $B, inM>, pkA)
    in
    [!Ltk($B, k), !Pk(A, pkA), In(<$B, dencM>) ]
    --[RunningB($B, A, m), Neq(A, $B), Eq(tag, 'init'), Eq(fst(msg), 'msg'), Decrypts(encM, m), Decrypt(dencM, inner)]->
    [Out(<A, outM>)]

rule A_Recv:
    let inner = adec(dencM, k)
        tag = fst(inner)
        B = fst(snd(inner))
        encM = snd(snd(inner))
        msg = adec(encM, k)
        m = snd(msg)
    in
    [!Ltk($A, k), !Pk(B, pkB), In(<$A, dencM>), StateA($A, B, m)]
    --[CommitA($A, B, m), Neq($A, B), Eq(tag, 'resp'), Eq(fst(msg), 'msg')]->
    []

lemma typing [sources]:
    "All msg v #i. Decrypts(msg, v) @ i
        ==> ( (Ex #j. KU(v) @ j & j < i)
            | (Ex #j. Encrypts(msg) @ j & j < i)
            )"

lemma executable:
    exists-trace
    "Ex A B m #i. (CommitA(A, B, m) @ i
        & not (A = B))"

lemma agreement:
    "All A B m #i.
        CommitA(A, B, m) @ i
        ==> Ex #j. RunningB(B, A, m) @ j & #j < #i"

lemma injectiveAgreement:
    "All A B m #i.
        CommitA(A, B, m) @ i
        ==> Ex #j. RunningB(B, A, m) @ j & #j < #i
            & All #k. (CommitA(A, B, m) @ #k  ==> #k = #i)"

lemma secrecy:
    "All A B m #i.
    CommitA(A, B, m) @ i
    ==> not (Ex #k. K(m) @ k)
    //   | (Ex #c. Compromised(A) @ c)
    //   | (Ex #c. Compromised(B) @ c)
    "

end
