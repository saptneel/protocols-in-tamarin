theory double_aenc
    // configuration: "--auto-sources"
begin

builtins: asymmetric-encryption

restriction UniqueKeyReg:
    "All X k1 k2 #i #j. ((KeyReg(X, k1) @ i) & (KeyReg(X, k2) @ j)) ==> #i = #j"

restriction Neq:
    "All x y #i. Neq(x, y) @ i ==> not (x = y)"

restriction Eq:
    "All x y #i. Eq(x, y) @ i ==> (x = y)"

rule Register:
    [Fr(~k)]
    --[KeyReg($X, ~k)]->
    [!Ltk($X, ~k), !Pk($X, pk(~k)), Out(pk(~k))]

// rule Compromise:
//     [!Ltk($X, ~k)]
//     --[Compromised($X)]->
//     [Out(~k)]

rule A_Init:
    [!Ltk($A, k), !Pk($B, pkB), Fr(~m)]
    --[RunningA($A, $B, ~m), Neq($A, $B), Encrypts(aenc(~m, pkB)), Encrypts(aenc(<'init', $A, aenc(~m, pkB)>, pkB))]->
    [Out(<$B, aenc(<'init', $A, aenc(~m, pkB)>, pkB)>), StateA($A, $B, ~m)]

rule B_Resp:
    let inner = snd(adec(dencM, k))
        encM = snd(inner)
        m = adec(encM, k)
        A = fst(inner)
    in
    [!Ltk($B, k), !Pk(A, pkA), In(<$B, dencM>) ]
    --[RunningB($B, A, m), Eq(fst(inner), 'init'), Neq(A, $B),
    Decrypts(dencM, m), Decrypts(encM, m), Encrypts(aenc(m, pkA)), Encrypts(aenc(<'resp', $B, aenc(m, pkA)>, pkA))]->
    [Out(<A, aenc(<'resp', $B, aenc(m, pkA)>, pkA)>)]

rule A_Recv:
    let inner = snd(adec(dencM, k))
        encM = snd(inner)
        msg = adec(encM, k)
        bid = fst(inner)
    in
    [!Ltk($A, k), !Pk(B, pkB), In(<$A, dencM>), StateA($A, B, m)]
    --[CommitA($A, B, m), Neq($A, B), Eq(msg, m), Eq(fst(inner), 'resp'), Eq(B, bid)]->
    []

lemma typing [sources]:
    "All msg m #i. Decrypts(msg, m) @ i
        ==> ( (Ex #j. KU(m) @ j & j < i)
            | (Ex #j. KU(msg) @ j & j < i)
            | (Ex #j. Encrypts(msg) @ j & j < i)
            )"

lemma executable:
    exists-trace
    "Ex A B m #i. (CommitA(A, B, m) @ i
        & not (A = B))"

lemma agreement:
    "All A B m #i.
        CommitA(A, B, m) @ i
        ==> Ex #j. RunningB(B, A, m) @ j & #j < #i"

lemma secrecy:
    "All A B m #i.
    CommitA(A, B, m) @ i
    ==> not (Ex #k. K(m) @ k)
    //   | (Ex #c. Compromised(A) @ c)
    //   | (Ex #c. Compromised(B) @ c)
    "

end
