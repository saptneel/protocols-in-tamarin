theory wide_mouthed_frog
    configuration: "--auto-sources"
begin

builtins: symmetric-encryption

restriction UniqueKeyGen:
    "All X k1 k2 #i #j.
        (KeyGen(X, k1) @ i) & (KeyGen(X, k2) @ j)
        ==> #i = #j"

rule Register:
    [Fr(~kxs)]
    --[KeyGen($X, ~kxs)]->
    [!Ltk($X, ~kxs)]

rule RevealLtk:
    [!Ltk($X, kxs)]
    --[Reveal($X)]->
    [Out(kxs)]

rule A:
    [!Ltk($A, kas), Fr(~Ta), Fr(~Kab)]
    --[Out_A(senc(<~Ta, $B, ~Kab>, kas), ~Kab), Created($A, $B, ~Kab, ~Ta)]->
    [Out(<$A, senc(<'1', ~Ta, $B, ~Kab>, kas)>)]

rule S_Relay:
    [!Ltk(X, kxs), !Ltk(Y, kys),
      In(<X, senc(<'1', Ta, Y, k>, kxs)>), Fr(~Ts)]
    --[In_S(senc(<'1', Ta, Y, k>, kxs), k), Forwarded(X, Y, k, Ta, ~Ts)]->
    [Out(senc(<'2', ~Ts, X, k>, kys))]

rule B:
    [!Ltk($B, kbs), In(senc(<'2', Ts, A, k>, kbs))]
    --[Accepted(A, $B, k, Ts)]->
    []

lemma executable:
  exists-trace
  "Ex A B kab Ts #i. Accepted(A, B, kab, Ts) @ i"

// lemma sources [sources]:
//     "All m x #i. In_S(m, x) @ #i
//         ==> (Ex #j. KU(x) @ #j & #j < #i)
//             | (Ex #j. Out_A(m, x) @ #j & #j < #i)"

// lemma kab_secret:
//   "All A B kab Ts #i.
//     Accepted(B, A, kab, Ts) @ i
//     ==> not (Ex #k. K(kab) @ k)
//         | (Ex #r. Reveal(A) @ r)
//         | (Ex #r. Reveal(B) @ r)"

lemma noninjectiveB:
  "All B A kab Ts #i.
    ((Accepted(A, B, kab, Ts) @ i)
    & not (Ex #j. Reveal(A) @ j)
    & not (Ex #k. Reveal(B) @ k))
    ==> Ex Ta #j. Created(A, B, kab, Ta) @ j
    & #j < #i
    & not(Ts = Ta)"

lemma uniqueForward:
  "All A B kab Ta Ts #i #j.
    Forwarded(A, B, kab, Ta, Ts) @ i & Forwarded(A, B, kab, Ta, Ts) @ j
    ==> #i = #j"

end