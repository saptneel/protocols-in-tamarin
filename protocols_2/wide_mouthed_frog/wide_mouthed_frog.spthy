theory wide_mouthed_frog
    // configuration: "--auto-sources"
begin

builtins: symmetric-encryption

restriction UniqueKeyGen:
    "All X k1 k2 #i #j.
        (KeyGen(X, k1) @ i) & (KeyGen(X, k2) @ j)
        ==> #i = #j"

rule Register:
    [Fr(~kxs)]
    --[KeyGen($X, ~kxs)]->
    [!Ltk($X, ~kxs)]

// rule RevealLtk:
//     [!Ltk($X, kxs)]
//     --[Reveal($X)]->
//     [Out(kxs)]

rule A:
    [!Ltk($A, kas), Fr(~Ta), Fr(~Kab)]
    --[Out_A(senc(<'1', ~Ta, $B, ~Kab>, kas)), Created($A, $B, ~Kab)]->
    [Out(<$A, senc(<'1', ~Ta, $B, ~Kab>, kas)>)]

rule S_Relay:
    [!Ltk(X, kxs), !Ltk(Y, kys), In(<X, senc(<'1', Ta, Y, k>, kxs)>), Fr(~Ts)]
    --[In_S(senc(<'1', Ta, Y, k>, kxs), k), Forwarded(X, Y, k)]->
    [Out(senc(<'2', ~Ts, X, k>, kys))]

rule B:
    [!Ltk($B, kbs), In(senc(<'2', Ts, A, k>, kbs))]
    --[Accepted(A, $B, k)]->
    []

lemma executable:
  exists-trace
  "Ex A B kab #i #j #k. Accepted(A, B, kab) @ i
                    & Forwarded(A, B, kab) @ j
                    & j < i
                    & Created(A, B, kab) @ k
                    & k < j
                    "

lemma typing [sources]:
    "All m x #i. In_S(m, x) @ i
        ==> (Ex #j. KU(x) @ j & j < i)
            | (Ex #j. Out_A(m) @ j & j < i)"

lemma kab_secret:
  "All A B kab #i.
    (Accepted(B, A, kab) @ i
    ==> not (Ex #k. K(kab) @ k))
    "

lemma noninjectiveB:
  "All B A kab #i.
    Accepted(A, B, kab) @ i
    ==> Ex #j. Forwarded(A, B, kab) @ j
        & j < i
        "

lemma injectiveB:
  "All B A kab #i.
    Accepted(A, B, kab) @ i
    ==> Ex #j. Forwarded(A, B, kab) @ j
        & j < i
        & (All #k. Accepted(A, B, kab) @ k
            ==> #j = k)
        "

lemma noninjectiveS:
  "All A B kab #i.
    (Forwarded(A, B, kab) @ i)
    ==> Ex #j. Created(A, B, kab) @ j
        & j < i
        "

lemma injectiveS:
  "All A B kab #i.
    (Forwarded(A, B, kab) @ i)
    ==> Ex #j. Created(A, B, kab) @ j
        & j < i
        & (All #k. Forwarded(A, B, kab) @ k
            ==> #j = k)
        "

end