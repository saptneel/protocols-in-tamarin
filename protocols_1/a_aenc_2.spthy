theory Async2
    // configuration: "--auto-sources"
begin

builtins: asymmetric-encryption

restriction UniqueKeyReg:
    "All X k1 k2 #i #j. ((KeyReg(X, k1) @ i) & (KeyReg(X, k2) @ j)) ==> #i = #j"

restriction Neq:
    "All x y #i. Neq(x, y) @ i ==> not (x = y)"

restriction Eq:
    "All x y #i. Eq(x, y) @ i ==> (x = y)"

rule Register:
    [Fr(~k)]
    --[KeyReg($X, ~k)]->
    [!Ltk($X, ~k), !Pk($X, pk(~k)), Out(pk(~k))]

rule Compromise:
    [!Ltk($X, ~k)]
    --[Compromised($X)]->
    [Out(~k)]

rule A_Init:
    [!Ltk($A, k), !Pk($B, pkB), Fr(~m)]
    --[RunningA($A, $B, ~m), Neq($A, $B), Encrypts(~m), Encrypts(<$A, aenc(~m, pkB)>)]->
    [Out(<$B, aenc(<$A, aenc(~m, pkB)>, pkB)>), StateA($A, $B, ~m)]

rule B_Resp:
    let inner = adec(dencM, k)
        encM = snd(inner)
        m = adec(encM, k)
        A = fst(inner)
    in
    [!Ltk($B, k), !Pk(A, pkA), In(<$B, dencM>) ]
    --[RunningB($B, A, m), Neq(A, $B), Decrypts(inner), Decrypts(m), Encrypts(m), Encrypts(<$B, aenc(m, pkA)>)]->
    [Out(<A, aenc(<$B, aenc(m, pkA)>, pkA)>)]

rule A_Recv:
    let inner = adec(dencM, k)
        encM = snd(inner)
        msg = adec(encM, k)
        bid = fst(inner)
    in
    [!Ltk($A, k), !Pk(B, pkB), In(<$A, dencM>), StateA($A, B, m)]
    --[CommitA($A, B, m), Neq($A, B), Eq(msg, m), Eq(B, bid), Decrypts(inner), Decrypts(msg)]->
    []

// lemma sources [sources, use_induction]:
//     "All c #i. Decrypts(c) @ #i
//         ==> (Ex #j. KU(c) @ #j & #j < #i)
//             | (Ex #j. Encrypts(c) @ #j & #j < #i)"

lemma executable:
    exists-trace
    "Ex A B m #i. (CommitA(A, B, m) @ i
        & not (A = B))"

lemma agreement:
    "All A B m #i.
        CommitA(A, B, m) @ i
        ==> Ex #j. RunningB(B, A, m) @ j & #j < #i"

lemma secrecy:
    "All A B m #i.
    CommitA(A, B, m) @ i
    ==> not (Ex #k. K(m) @ k)
      | (Ex #c. Compromised(A) @ c)
      | (Ex #c. Compromised(B) @ c)
    "

end
