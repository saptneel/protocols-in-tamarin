// Too quick?
theory DiffieHellman
begin

builtins: diffie-hellman

restriction Neq:
    "All x #i. Neq(x, x) @ i ==> F"

restriction Eq:
    "All x y #i. Eq(x, y) @ i ==> x = y"


rule A_Init:
    [ Fr(~x), Fr(~g), Fr(~p) ]
    --[ RunningA($A, $B, ~x, ~g, ~p) ]->
    [ Out(<$A, $B, ~g, ~p, ~g^~x>), StateA($A, $B, ~x, ~g, ~p)]

rule B_Recv:
    [ In(<A, $B, g, p, gx>), Fr(~y)]
    --[ RunningB($B, A, gx^~y), Neq(gx, gx^~y)]->
    [ Out(<$B, A, g^~y>), StateB($B, A, gx, ~y) ]

rule A_Recv:
    [ StateA($A, $B, x, g, p), In(<$B, $A, gy>) ]
    --[ CommitA($A, $B, gy^x), Neq(gy, gy^x), Neq(gy, g) ]->
    []

lemma secrecy:
    "All A B key #i #j. CommitA(A, B, key) @ i & RunningB(B, A, key) @ j
     ==> not (Ex #k. K(key) @ k)"
    

lemma auth:
    "All A B key #i. CommitA(A, B, key) @ i
        ==> (Ex #j. RunningB(B, A, key) @ j)"

lemma auth_injective:
    "All A B key #i. CommitA(A, B, key) @ i
        ==> (Ex #j. RunningB(B, A, key) @ j
            & (All #k. CommitA(A, B, key) @ k ==> #i = #k))"

end