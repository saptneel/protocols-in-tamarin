theory X509_3
begin

builtins: asymmetric-encryption, hashing

// Rules

rule Register:
    [ Fr(~ltk) ]
    -->
    [ !Ltk($X, ~ltk), !Pk($X, pk(~ltk)), Out(pk(~ltk)) ]

rule A_Init:
    let m1 = <~Ta, ~Na, $B, $Xa, aenc(~Ya, pkB)>
        m1_sig = aenc(h(m1), ~ltkA)
    in
    [ Fr(~Na), Fr(~Ta), Fr(~Ya), !Ltk($A, ~ltkA), !Pk($B, pkB) ]
    --[ ]->
    [ Out(<$A, m1, m1_sig>), StateA1($A, $B, ~Na, ~Ta, ~Ya, ~ltkA, pkB) ]

rule B_Recv_Resp:
    let m1 = <Ta, Na, $B, Xa, cipherYa>
        m1_sig = aenc(h(m1), ltkA)
        m2 = <$B, ~Tb, ~Nb, $A, Na, $Xb, aenc(~Yb, pkA)>
        m2_sig = aenc(h(m2), ~ltkB)
    in
    [ In(<$A, Ta, Na, $B, Xa, cipherYa, m1_sig>), 
      Fr(~Nb), Fr(~Tb), Fr(~Yb), !Ltk($B, ~ltkB), !Pk($A, pkA) ]
    --[ RunningB($B, $A, ~Nb) ]->
    [ Out(<m2, m2_sig>), StateB1($B, $A, Na, ~Nb, ~Tb, ~Yb, ~ltkB, pkA) ]

rule A_Recv_Resp:
    let m2 = <$B, Tb, Nb, $A, ~Na, Xb, cipherYb>
        m2_sig = aenc(h(m2), ltkB)
        m3_sig = aenc(Nb, ~ltkA)
    in
    [ StateA1($A, $B, ~Na, ~Ta, ~Ya, ~ltkA, pkB), 
      In(<m2, m2_sig>) ]
    --[ CommitA($A, $B, ~Na, Nb), RunningA($A, $B, Nb) ]->
    [ Out(<$A, m3_sig>) ]

rule B_Final:
    let m3_sig = aenc(~Nb, pkA)
    in
    [ StateB1($B, $A, Na, ~Nb, ~Tb, ~Yb, ~ltkB, pkA), 
      In(<$A, m3_sig>) ]
    --[ CommitB($B, $A, Na, ~Nb) ]->
    [ ]


// Lemmas

lemma executable:
  exists-trace
  "Ex A B Na Nb #i #j. CommitB(B, A, Na, Nb) @ i & CommitA(A, B, Na, Nb) @ j"

lemma injective_agreement_B:
  "All B A Na Nb #i. CommitB(B, A, Na, Nb) @ i
   ==> (Ex #j. RunningA(A, B, Nb) @ j
        &  (All #k. CommitB(B, A, Na, Nb) @ k ==> #k = #i))"

lemma injective_agreement_A:
  "All A B Na Nb #i. CommitA(A, B, Na, Nb) @ i
   ==> (Ex #j. RunningB(B, A, Nb) @ j
        &  (All #k. CommitA(A, B, Na, Nb) @ k ==> #k = #i))"

end