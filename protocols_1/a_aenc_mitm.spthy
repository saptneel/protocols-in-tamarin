theory Async
begin

builtins: asymmetric-encryption

restriction UniqueKeyReg:
    "All X k1 k2 #i #j. ((KeyReg(X, k1) @ i) & (KeyReg(X, k2) @ j)) ==> #i = #j"

restriction Neq:
    "All x y #i. Neq(x, y) @ i ==> not (x = y)"

rule Register:
    [Fr(~k)]
    --[KeyReg($X, ~k)]->
    [!Ltk($X, ~k), !Pk($X, pk(~k)), Out(pk(~k))]

rule A_Init:
    [!Ltk($A, k), !Pk($B, pkB), Fr(~m)]
    --[RunningA($A, $B, ~m), Neq($A, $B)]->
    [Out(<$A, $B, aenc(~m, pkB)>), StateA($A, $B, ~m)]

rule B_Resp:
    [!Ltk($B, k), !Pk($A, pkA), In(<$A, $B, encM>)]
    --[CommitB($A, $B, adec(encM, k)), Neq($A, $B)]->
    [Out(<$B, $A, aenc(adec(encM, k), pkA)>)]

rule A_Recv:
    [!Ltk($A, k), !Pk($B, pkB), In(<$B, $A, encM>), 
        StateA($A, $B, adec(encM, k))]
    --[CommitA($A, $B, adec(encM, k)), Neq($A, $B)]->
    []

rule Compromise:
    [!Ltk($X, k)]
    --[Compromised($X)]->
    [Out(k)]

lemma executable:
    exists-trace
    "Ex A B m #i #j. (CommitA(A, B, m) @ i & CommitB(A, B, m) @ j
        & not (A = B))"

lemma auth:
    "All A B m #i. CommitB(A, B, m) @ i
    ==> (Ex #j. RunningA(A, B, m) @ j & j < i)
            & (All #k. CommitB(A, B, m) @ k ==> #i = #k)"

lemma secrecy:      
    all-traces
    "All A B m #i #j.
    CommitB(A, B, m) @ i & CommitA(A, B, m) @ j
    ==> not (Ex #k. K(m) @ k)
      | (Ex #c. Compromised(A) @ c)
      | (Ex #c. Compromised(B) @ c)"
    // "not(
    //     Ex A B m #i #j #k.
    //         CommitB(A, B, m) @ i
    //         & CommitA(A, B, m) @ j
    //         & K(m) @ k
    //         & not (Ex #c. Compromised(A) @ c)
    //         & not (Ex #c. Compromised(B) @ c)
    // )"
end
