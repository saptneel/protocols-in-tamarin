//Had to remove hashes of out msgs?
// Should B also create the secretAB
theory BullsProtocol
begin

builtins: xor, hashing, symmetric-encryption

rule Register_Key:
    [Fr(~k)]
    --[KeyReg($X, ~k)]->
    [!Ltk($X, ~k)]

rule A_Init:
    [Fr(~Na), !Ltk($A, kAS)]
    -->
    [Out(<$A, $B, ~Na>), StateA1($A, $B, ~Na, kAS)]

rule B_Forward:
    [Fr(~Nb), !Ltk($B, kBS), In(<$A, $B, Na>)]
    -->
    [Out(<$B, $C, ~Nb, $A, Na>), StateB1($B, $A, $C, ~Nb, kBS)]

rule C_Forward:
    [Fr(~Nc), !Ltk($C, kCS), In(<$B, $C, Nb, $A, Na>)]
    -->
    [Out(<$C, $S, ~Nc, $B, Nb, $A, Na>), StateC1($C, $B, ~Nc, kCS)]

rule Server:
    let keyAB = <$A, $B, (~Kab ⊕ h(Na, kAS)), senc(<$A, $B, Na>, ~Kab)>
        keyBA = <$B, $A, (~Kab ⊕ h(Nb, kBS)), senc(<$B, $A, Nb>, ~Kab)>
        keyBC = <$B, $C, (~Kbc ⊕ h(Nb, kBS)), senc(<$B, $C, Nb>, ~Kbc)>
        keyCB = <$C, $B, (~Kbc ⊕ h(Nc, kCS)), senc(<$C, $B, Nc>, ~Kbc)>
    in
    [In(<$C, $S, Nc, $B, Nb, $A, Na>), !Ltk($A, kAS), !Ltk($B, kBS), !Ltk($C, kCS), Fr(~Kab), Fr(~Kbc)]
    --[ServerInit($S, $A, $B, $C, ~Kab, ~Kbc)]->
    [Out(<keyAB, keyBA, keyBC, keyCB>)]

rule C_Recv:
    // let xorCB = Kbc ⊕ h(~Nc, ~kCS)
    //     sencCB = senc(<$C, $B, ~Nc>, Kbc)
    // in
    [StateC1($C, $B, ~Nc, kCS), In(<keyAB, keyBA, keyBC, <$C, $B, Kbc ⊕ h(<~Nc, kCS>), senc(<$C, $B, ~Nc>, Kbc)>>)]
    --[CommitC($C, $B, Kbc), SecretBC($B, $C, Kbc)]->
    [Out(<keyAB, keyBA, keyBC>) ]

rule B_Recv:
    // let xorBA = Kab ⊕ h(~Nb, ~kBS)
    //     xorBC = Kbc ⊕ h(~Nb, ~kBS)
    //     sencBA = senc(<$B, $A, ~Nb>, Kab)
    //     sencBC = senc(<$B, $C, ~Nb>, Kbc)
    // in
    [StateB1($B, $A, $C, ~Nb, kBS), In(<keyAB, <$B, $A, Kab ⊕ h(<~Nb, kBS>), senc(<$B, $A, ~Nb>, Kab)>, <$B, $C, Kbc ⊕ h(<~Nb, kBS>), senc(<$B, $C, ~Nb>, Kbc)>>)]
    --[CommitB($B, $A, Kab), CommitB($B, $C, Kbc), SecretAB($A, $B, Kab), SecretBC($B, $C, Kbc)]->
    [Out(keyAB)]

rule A_Recv:
    // let xorAB = Kab ⊕ h(~Na, ~kAS) 
    //     sencAB = senc(<$A, $B, ~Na>, Kab)
    // in  
    [StateA1($A, $B, ~Na, kAS), In(<$A, $B, Kab ⊕ h(<~Na, kAS>), senc(<$A, $B, ~Na>, Kab)>)]
    --[CommitA($A, $B, Kab), SecretAB($A, $B, Kab)]->
    []

rule Compromise_Node:
    [!Ltk($X, k) ]
    --[Compromised($X)]->
    [Out(k)]

lemma executable:
  exists-trace
  "Ex S A B C Kab Kbc #i. ServerInit(S, A, B, C, Kab, Kbc) @ i"

lemma secrecy_Kab:
  "All A B Kab #i. (SecretAB(A, B, Kab) @ i)
   ==> not ((Ex #j. K(Kab) @ j)
   & not (Ex #k. Compromised(A) @ k)
   & not (Ex #k. Compromised(B) @ k))"

lemma secrecy_Kbc:
  "All B C Kbc #i. (SecretBC(B, C, Kbc) @ i)
   ==> not ((Ex #j. K(Kbc) @ j)
   & not (Ex #k. Compromised(B) @ k)
   & not (Ex #k. Compromised(C) @ k))"

end