theory WideMouthedFrog
begin

builtins: symmetric-encryption

restriction UniqueKeyGen:
    "All X k1 k2 #i #j.
        (KeyGen(X, k1) @ i) & (KeyGen(X, k2) @ j)
        ==> #i = #j"

rule Register:
    [Fr(~kxs)]
    --[KeyGen($X, ~kxs)]->
    [!Ltk($X, ~kxs)]

rule RevealLtk:
    [!Ltk($X, kxs) ]
    --[Reveal($X)]->
    [Out(kxs)]

rule A:
    [!Ltk($A, kas), Fr(~Ta), Fr(~Kab) ]
    --[Created($A, $B, ~Kab)]->
    [Out(<$A, senc(<~Ta, $B, ~Kab>, kas)>)]

rule S_Relay:
let
    tuple = sdec(cipher, kxs)
    t = fst(tuple)
    Y = fst(snd(tuple))
    k = snd(snd(tuple))
in
    [!Ltk(X, kxs), !Ltk(Y, kys),
      In(<X, cipher>), Fr(~Ts)]
    --[Forwarded(X, Y, k)]->
    [Out(senc(<~Ts, X, k>, kys))]

rule B:
let
    tuple = sdec(cipher, kbs)
    ts = fst(tuple)
    A = fst(snd(tuple))
    k = snd(snd(tuple))
in
    [!Ltk($B, kbs), In(cipher)]
    --[Accepted($B, A, k)]->
    []

lemma executable:
  exists-trace
  "Ex A B kab #i. Accepted(B, A, kab) @ i"

lemma kab_secret:
  "All A B kab #i.
    Created(A, B, kab) @ i
    ==> not (Ex #k. K(kab) @ k)
        | (Ex #r. Reveal(A) @ r)
        | (Ex #r. Reveal(B) @ r)"

lemma noninjectiveB:
  "All B A kab #i.
    Accepted(B, A, kab) @ i
    ==> Ex #j. Created(A, B, kab) @ j & #j < #i"

lemma single_forward:
  "All A B kab #i #j.
    Forwarded(A, B, kab) @ i & Forwarded(A, B, kab) @ j
    ==> #i = #j"

end